# SmartInvoice AI - Backend Environment Configuration Example
# Copy this file to .env for local development or set in your cloud provider (Render/Railway/Fly.io)

# Application
APP_NAME=SmartInvoice AI
APP_ENV=development
DEBUG=True
PORT=8000

# Security (Set a strong secret key in production)
SMARTINVOICE_API_KEY=smartinvoice-secret-key-2026

# Cloud Supabase Database & Sync (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# OCR Engine (Local binary path or system command)
TESSERACT_CMD=tesseract

# CORS Allowed Origins (Comma-separated for custom domains)
# Example: https://mycustominvoice.com,https://app.mycustominvoice.com
CORS_ORIGINS=
