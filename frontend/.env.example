# SmartInvoice AI - Frontend Environment Configuration Example
# Set these variables in Vercel project settings or copy to .env.local for local testing

# URL of the FastAPI Backend (Leave blank if running on the same host or proxying via Vite)
# Example for Render deployment: https://smartinvoice-api.onrender.com
VITE_API_BASE_URL=

# Backend Secret API Key (Matches SMARTINVOICE_API_KEY on the backend)
VITE_API_KEY=smartinvoice-secret-key-2026
